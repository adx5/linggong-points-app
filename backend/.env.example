# backend/.env.example (环境变量模板，请复制为 .env 并填入真实值)

# 数据库连接
DATABASE_URL=postgresql://user:password@localhost:5432/linggong
REDIS_URL=redis://localhost:6379/0

# 安全密钥
SECRET_KEY=your_super_secret_key_here

# ==========================================
# 环境标识 (dev / staging / prod)
# ==========================================
ENV=staging

# ==========================================
# 🚨 核心功能开关 (PR-1 / PR-2 引入)
# 默认值说明：生产环境(prod)下，安全侧必须全为 False。
# ==========================================
# 是否允许未登录游客访问白名单接口
ENABLE_GUEST_MODE=True

# 是否开启角色拆分（user / worker）
ENABLE_ROLE_SPLIT=False

# 是否开启联系方式 contact_token 功能
ENABLE_CONTACT_TOKEN=False

# 是否强制校验 App 签名（广告防刷）
REQUIRE_APP_SIGNATURE=True

# ==========================================
# 🤖 外部服务 API 配置 (DeepSeek 大模型)
# ==========================================
# DeepSeek API 密钥：用于后端调用大模型进行岗位文本合规分析、AI风控研判。
# 🚨 安全警告：严禁提交到代码仓库，严禁在前端暴露。
DEEPSEEK_API_KEY=sk-替换为你刚刚重新生成的密钥

# DeepSeek 接口基础地址：官方默认 https://api.deepseek.com/v1
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 调用的模型名称：可选 deepseek-chat (通用对话) 或 deepseek-coder (代码专用，但对话也可用)
DEEPSEEK_MODEL=deepseek-chat

# ==========================================
# ⚙️ AI 风控与匹配算法参数 (预留配置，后续 PR 生效)
# ==========================================
# 风险拦截阈值：当 AI 分析出的风险分数大于此值时，系统将自动标记为高危并拦截。
# 取值范围：0.0 ~ 1.0。当前设定为 0.7，即 70% 以上概率判定为违规。
RISK_THRESHOLD=0.7

# 最大匹配轮次：在智能推荐（如找牛人、找岗位）时，若首轮结果不满，系统自动放宽条件重试的最大次数。
# 当前设定为 2，防止无限循环耗尽算力。
MAX_MATCH_ROUNDS=2

# 大模型 Mock 模式开关：
# True: 本地开发使用。跳过真实 API 调用，直接返回写死的模拟数据（节约 Token 费用，加快调试）。
# False: Staging/生产环境使用。真实发起 API 请求进行语义分析。
MOCK_MODE=False

# ==========================================
# 🖼️ 图片服务 Token (BeeIMG)
# ==========================================
# 用于营业执照、身份证等图片的云端 OCR 识别或安全合规校验。
# 🚨 安全警告：同样严禁泄露。
BEEIMG_TOKEN=替换为你刚刚重新生成的token

# ==========================================
# 📋 附录：环境变量与开关默认值说明表
# ==========================================
# | 开关名称 | 默认值 | 环境差异 | 生效方式 | 改错怎么回滚 |
# | :--- | :--- | :--- | :--- | :--- |
# | ENABLE_GUEST_MODE | False | Staging: True, Prod: False | 修改 .env 后重启后端服务 | 改回 False 并重启 |
# | ENABLE_ROLE_SPLIT | False | Staging: False, Prod: False | 同上 | 改回 False 并重启 |
# | ENABLE_CONTACT_TOKEN | False | Staging: True, Prod: False | 同上 | 改回 False 并重启 |
# | REQUIRE_APP_SIGNATURE | True | Staging: True, Prod: True | 同上 | 改回 True 并重启 |